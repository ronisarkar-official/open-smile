# ── Better Auth ───────────────────────────────────────────
BETTER_AUTH_SECRET=                             # Generate: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000           # App base URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── Supabase / PostgreSQL (required for Better Auth) ──────
DATABASE_URL=                                  # e.g. postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=                      # e.g. https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                     # From Supabase Dashboard > Settings > API

# ── OAuth Providers (optional) ────────────────────────────
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) — used for OTP delivery ──────────────────
# Gmail example: use an App Password, not your regular password
EMAIL_USER=
EMAIL_PASS=

# ── App branding (optional) ───────────────────────────────
NEXT_PUBLIC_APP_NAME=My App


# ── ImageKit (file uploads) ────────────────────────────────
# Get keys from: https://imagekit.io/dashboard/developer/api-keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Environment & Features ─────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_ENABLE_PWA=false

# ── Admin Access ───────────────────────────────────────────
ADMIN_EMAILS=ronisarkar10938@gmail.com

# ── Cron Security (Vercel Crons) ───────────────────────────
# Sent as Bearer token in Authorization header by Vercel
CRON_SECRET=
