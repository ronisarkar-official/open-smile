# Vercel deployment ignore rules
# Keep build payloads lean and prevent dev-only files from inflating lambda bundles

# Cache and local tooling
.git
.github
.agents
.cursor
.claude
.opencode
.vscode
.venv
env/
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Graphify knowledge graph outputs
graphify-out

# Python test suite & caches
backend_py/tests
.pytest_cache
__pycache__
*.py[cod]

# Local artifacts & temporary files
brain/
